# Base URL of the payments API.
#
# Leave EMPTY to call the same origin (useful if the API is reverse-proxied
# under the same host). Set it when the API lives on its own subdomain.
#
# Local development, with the backend running on port 8080:
VITE_API_BASE_URL=http://localhost:8080
#
# Production:
# VITE_API_BASE_URL=https://vedicheritage-592313850466.us-central1.run.app
#
# NOTE: Vite inlines every VITE_* variable into the built JavaScript, so it is
# public. Never put a secret here - API tokens and signing keys belong only in
# the backend environment. Only the VITE_ prefix is exposed; a NEXT_PUBLIC_*
# name copied from a Next.js project is silently ignored by Vite.


# ---------------------------------------------------------------------------
# Analytics
#
# Both are OFF when empty, which is what dev, test and every preview build
# should run with - so that testing the payment flow cannot report fake ticket
# sales into the live ad account or the live GA property. Switching tracking on
# is a deployment decision, not a code change.
#
# To verify them without polluting production data, see "Testing analytics" in
# README.md - Meta's Test Events tool and GA4's DebugView both work against a
# local dev server.
#
# Both are public by design: each is inlined into the bundle and readable in
# page source. That is expected for these two IDs and neither is a secret.
# ---------------------------------------------------------------------------

# Meta (Facebook) Pixel ID from Events Manager, e.g. 123456789012345.
VITE_META_PIXEL_ID=

# Google Analytics 4 measurement ID from Admin > Data streams, e.g. G-XXXXXXXXXX.
VITE_GA_MEASUREMENT_ID=

# Google Ads conversion tracking.
#
# The account ID from the Google tag setup page, e.g. AW-18494963625. Setting
# it alone reports no conversions, but it does load the tag that turns a `gclid`
# on an inbound ad click into the cookie later conversions are attributed
# against - so it is the one that has to be live for any of this to work.
VITE_GOOGLE_ADS_ID=

# Conversion labels. Each is the part AFTER the slash in the `send_to` value
# Google shows you - in `AW-18494963625/dAG7CP6WxpYdEKn_ivNE`, the label is
# `dAG7CP6WxpYdEKn_ivNE`. One label per conversion action, from
# Google Ads > Goals > Conversions > Summary > (action) > Tag setup.
#
# Lead: fired when the phone/email fallback dialog opens, i.e. a booking that
# will happen off-site because online payment was unavailable.
VITE_GOOGLE_ADS_LEAD_LABEL=

# Purchase: fired when a payment settles, with the order value and currency, so
# Smart Bidding can optimise for revenue rather than lead count. Needs its own
# conversion action in Ads - create one with Value: "Use different values for
# each conversion". Leave empty until it exists; purchases are then simply not
# reported to Ads.
VITE_GOOGLE_ADS_PURCHASE_LABEL=
